 )
 
 type segment struct {
 	kind  segmentKind
 	name  string
 	index int
+	value string
 }
 
+var rootFilterPattern = regexp.MustCompile(`^\[\?\(\s*@\.([A-Za-z_][A-Za-z0-9_]*)\s*==\s*(?:'([^']*)'|"([^"]*)")\s*\)\]`)
+
 func (r Rule) String() string {
 	return r.raw
 }
@@ -105,6 +111,15 @@ func Parse(raw string) (Rule, error) {
